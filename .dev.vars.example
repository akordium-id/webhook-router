XENDIT_WEBHOOK_TOKEN="xnd_webhook_verification_token_here"

# 1. Dynamic Environment Variables per Product:
# Pola: [PREFIX]_WEBHOOK_URL (otomatis cocok dengan order_id / external_id seperti "dompiku-123" atau "dompiku_123")
DOMPIKU_WEBHOOK_URL="https://dompiku.akordium.id/api/webhooks/xendit"
VISTEO_WEBHOOK_URL="https://visteo-app.akordium.id/api/payment/webhook"
CRM_WEBHOOK_URL="https://crm.akordium.id/api/payment/webhook"

